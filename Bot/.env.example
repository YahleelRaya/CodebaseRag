# Copy this file to .env and fill in your values. Never commit .env.
PINECONE_API_KEY=pcsk_your_key_here
PINECONE_INDEX_NAME=codebase-rag
# Region used if ingest.py has to create the index
PINECONE_REGION=us-east-1
# Optional: codebase selected by default in the app's sidebar
PINECONE_NAMESPACE=
GROQ_API_KEY=gsk_your_key_here
# Any current chat model from https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b
